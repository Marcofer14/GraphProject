{
    // F5 runs the selected configuration under the debugger (breakpoints in src/ work).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: train (tiny, CPU)",
            "type": "debugpy",
            "request": "launch",
            "module": "neural_routing.ml.train",
            "args": ["--config-name", "cvrp20", "num_customers=10", "train.epochs=1",
                     "train.steps_per_epoch=5", "train.batch_size=4", "train.val_size=16",
                     "train.device=cpu", "train.resume=null", "train.checkpoint_dir=runs/debug_ckpt"],
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Train: CVRP-50 to 100 epochs",
            "type": "debugpy",
            "request": "launch",
            "module": "neural_routing.ml.train",
            "args": ["--config-name", "cvrp50", "train.epochs=100"],
            "console": "integratedTerminal"
        },
        {
            "name": "Train: CVRP-100",
            "type": "debugpy",
            "request": "launch",
            "module": "neural_routing.ml.train",
            "args": ["--config-name", "cvrp100"],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug: current test file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-p", "no:warnings", "-x"],
            "console": "integratedTerminal"
        }
    ]
}
