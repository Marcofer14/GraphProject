{
    // Run with Ctrl+Shift+P -> "Tasks: Run Task", or Ctrl+Shift+B for the default build task.
    // Training resumes automatically from checkpoints/<problem><n>_pomo_last.pt.
    "version": "2.0.0",
    "options": {
        "env": { "PYTHONUTF8": "1" }
    },
    "windows": {
        "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } }
    },
    "tasks": [
        {
            "label": "API: dev server (http://127.0.0.1:8000/docs)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "uvicorn", "neural_routing.api.app:app", "--host", "127.0.0.1",
                     "--port", "8000", "--reload", "--reload-dir", "src"],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Phase 4: train on REAL routes + matrices (~3-4 h)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.ml.train", "--config-name", "cvrp100_real_matrix"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Phase 4: evaluate on 200 real routes (vs phase 3)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.eval.benchmark", "--mode", "route", "--split",
                     "evaluation", "--n", "200", "--workers", "6", "--tag", "phase4", "--configs",
                     "reference", "ortools:10", "pyvrp:10",
                     "attention_ls@checkpoints/cvrp100_pomo_real.pt",
                     "attention@checkpoints/cvrp100_pomo_real.pt",
                     "attention_ls@checkpoints/cvrp100_pomo_amazon_ft.pt",
                     "attention_ls@checkpoints/cvrp100_pomo_amazon.pt",
                     "attention@checkpoints/cvrp100_pomo_amazon.pt"],
            "problemMatcher": []
        },
        {
            "label": "Phase 4: fine-tune CVRP-100 Amazon (~2 h)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.ml.train", "--config-name", "cvrp100_amazon_ft"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Train: CVRP-50 to 100 epochs",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.ml.train", "--config-name", "cvrp50", "train.epochs=100"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Train: CVRP-100 (~3 h)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.ml.train", "--config-name", "cvrp100"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Train: pick config",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.ml.train", "--config-name", "${input:config}", "${input:overrides}"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Train: CVRPTW-50 Amazon (time windows, ~2-3 h)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.ml.train", "--config-name", "cvrptw50_amazon"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Curriculum 1/2: CVRP-100 Amazon (from CVRP-50 Amazon, ~2.5 h)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.ml.train", "--config-name", "cvrp100_amazon"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Curriculum 2/2: CVRP-150 Amazon (from CVRP-100 Amazon, ~3.3 h)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.ml.train", "--config-name", "cvrp150_amazon"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Curriculum: 100 then 150 (overnight)",
            "dependsOrder": "sequence",
            "dependsOn": ["Curriculum 1/2: CVRP-100 Amazon (from CVRP-50 Amazon, ~2.5 h)",
                          "Curriculum 2/2: CVRP-150 Amazon (from CVRP-100 Amazon, ~3.3 h)"],
            "problemMatcher": []
        },
        {
            "label": "Final: 200 real Amazon routes (evaluation split)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.eval.benchmark", "--mode", "route", "--split",
                     "evaluation", "--n", "200", "--workers", "6", "--tag", "final", "--configs",
                     "reference", "savings_ls", "ortools:10", "pyvrp:10",
                     "attention_ls@checkpoints/cvrp150_pomo_amazon.pt",
                     "attention_ls@checkpoints/cvrp50_pomo_amazon.pt",
                     "attention_ls@checkpoints/cvrptw50_pomo_amazon.pt"],
            "problemMatcher": []
        },
        {
            "label": "Bench: CVRPTW-50 (tight windows 0.25)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.eval.synthetic_benchmark", "--distribution", "amazon",
                     "--time-windows", "--tw-tightness", "0.25", "--problem", "cvrp", "--size", "50",
                     "--n", "200", "--workers", "6", "--configs", "pyvrp:10", "ortools:10",
                     "savings_ls",
                     "attention_ls@checkpoints/cvrptw50_pomo_amazon.pt",
                     "attention_ls@checkpoints/cvrp50_pomo_amazon.pt"],
            "problemMatcher": []
        },
        {
            "label": "Bench: CVRPTW-50 (real windows 1.0)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.eval.synthetic_benchmark", "--distribution", "amazon",
                     "--time-windows", "--tw-tightness", "1.0", "--problem", "cvrp", "--size", "50",
                     "--n", "200", "--workers", "6", "--configs", "pyvrp:10", "savings_ls",
                     "attention_ls@checkpoints/cvrptw50_pomo_amazon.pt",
                     "attention_ls@checkpoints/cvrp50_pomo_amazon.pt"],
            "problemMatcher": []
        },
        {
            "label": "Experiment A: train CVRP-50 Amazon (customer-centric)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.ml.train", "--config-name", "cvrp50_amazon"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Experiment B: train CVRP-50 Amazon (old normalisation)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.ml.train", "--config-name", "cvrp50_amazon_all"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Experiment: compare A vs B vs uniform model (Amazon-like CVRP-50)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.eval.synthetic_benchmark", "--distribution", "amazon",
                     "--problem", "cvrp", "--size", "50", "--n", "200", "--workers", "6",
                     "--tag", "normalisation", "--configs", "pyvrp:10", "savings",
                     "attention@checkpoints/cvrp50_pomo_amazon.pt",
                     "attention@checkpoints/cvrp50_pomo_amazon_all.pt",
                     "attention@checkpoints/cvrp50_pomo.pt"],
            "problemMatcher": []
        },
        {
            "label": "Bench: CVRP-50 after 100 epochs",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.eval.synthetic_benchmark", "--problem", "cvrp", "--size", "50",
                     "--n", "200", "--workers", "6", "--configs", "pyvrp:10", "ortools:10", "attention",
                     "--checkpoint", "checkpoints/cvrp50_pomo.pt", "--tag", "e100"],
            "problemMatcher": []
        },
        {
            "label": "Bench: CVRP-100",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "neural_routing.eval.synthetic_benchmark", "--problem", "cvrp", "--size", "100",
                     "--n", "100", "--workers", "6", "--configs", "savings", "pyvrp:20", "ortools:20",
                     "attention", "--checkpoint", "checkpoints/cvrp100_pomo.pt"],
            "problemMatcher": []
        },
        {
            "label": "TensorBoard (live curves)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/tensorboard.exe",
            "args": ["--logdir", "runs", "--port", "6006"],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "panel": "dedicated" }
        },
        {
            "label": "Plot training curves",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["scripts/plot_training.py", "--x", "epoch"],
            "problemMatcher": []
        },
        {
            "label": "GPU usage (refresh 2 s)",
            "type": "shell",
            "command": "nvidia-smi",
            "args": ["-l", "2", "--query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu",
                     "--format=csv"],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "panel": "dedicated" }
        },
        {
            "label": "Check: lint + types + tests",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/ruff.exe check . ; ${workspaceFolder}/.venv/Scripts/mypy.exe ; ${workspaceFolder}/.venv/Scripts/python.exe -m pytest -p no:warnings",
            "group": "test",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "config",
            "type": "pickString",
            "description": "Training config (configs/*.yaml)",
            "options": ["tsp20", "cvrp20", "cvrp50", "cvrp100", "tsp20_rollout", "cvrp50_amazon",
                        "cvrp50_amazon_all", "cvrptw50_amazon"],
            "default": "cvrp50"
        },
        {
            "id": "overrides",
            "type": "promptString",
            "description": "Hydra overrides, e.g. train.epochs=100 (Enter for none)",
            "default": "train.resume=auto"
        }
    ]
}
